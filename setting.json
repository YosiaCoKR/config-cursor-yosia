{
  // ============================================
  // 🤖 CURSOR AI & WORKFLOW BOOST
  // ============================================
  "cursor.cpp.enablePartialAccepts": true,
  "cursor.terminal.cmdK": true,
  "editor.inlineSuggest.enabled": true,
  "cursor.general.showAiHints": false,
  "cursor.chat.showProjectContext": true,
  "vsintellicode.python.completionsEnabled": false,

  // ============================================
  // 🌌 VISUAL CORE (SynthWave84 + Manual Neon Boost)
  // ============================================
  "workbench.colorTheme": "SynthWave '84",
  "workbench.iconTheme": "simple-icons",
  "workbench.colorCustomizations": {
    "[SynthWave84]": {
      "editor.lineHighlightBackground": "#2b004655",
      "editor.lineHighlightBorder": "#ff00ee44",
      "tab.activeBorder": "#fffb00",
      "tab.activeForeground": "#fffb00",
      "editor.selectionBackground": "#ffffff30",
      "terminalCursor.foreground": "#ff00ee"
    }
  },

  // ============================================
  // ⌨️ TYPOGRAPHY (Clean & Expensive)
  // ============================================
  "editor.fontFamily": "'JetBrains Mono', 'FiraCode Nerd Font', Consolas, monospace",
  "editor.autoIndent": "advanced",
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.lineHeight": 29,
  "editor.fontWeight": "450",
  "editor.letterSpacing": 0.6,
  "editor.fontSmoothing": "antialiased",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic",
          "foreground": "#6b7a8f"
        }
      },
      {
        "scope": "keyword",
        "settings": {
          "fontStyle": "italic bold"
        }
      }
    ]
  },

  // ============================================
  // 🛸 IMMERSIVE UI (Zero Distraction)
  // ============================================
  "window.titleBarStyle": "custom",
  "workbench.editor.editorActionsLocation": "hidden",
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "workbench.tree.indent": 22,
  "workbench.tree.renderIndentGuides": "always",
  "explorer.compactFolders": false,

  // ============================================
  // ✨ ANIMATION & GLOW
  // ============================================
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.renderLineHighlight": "all",

  // ============================================
  // ⚡ FORMATTING (Per-Language, No Conflict)
  // ============================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "files.autoSave": "afterDelay",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true
  },
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": true
  },

  "[java]": {
    "editor.defaultFormatter": "Oracle.oracle-java"
  },

  // ============================================
  // 🔍 INTELLISENSE & AUTOCOMPLETE (Rich Suggestions)
  // ============================================
  "editor.suggestOnTriggerCharacters": true,
  "editor.quickSuggestionsDelay": 0,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.suggest.preview": true,
  "editor.suggest.showInlineDetails": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },

  // ============================================
  // 🐍 PYTHON & ML — cursorpyright + rich hints
  // ============================================
  "python.languageServer": "None",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,

  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.completeFunctionParens": true,
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "cursorpyright.analysis.indexing": true,
  "cursorpyright.analysis.userFileIndexingLimit": 2000,
  "cursorpyright.analysis.inlayHints.variableTypes": true,
  "cursorpyright.analysis.inlayHints.functionReturnTypes": true,
  "cursorpyright.analysis.inlayHints.callArgumentNames": true,

  // ============================================
  // 🐹 GOLANG — gopls full docs + placeholders
  // ============================================
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  "go.autocompleteUnimportedPackages": true,
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "go.vetOnSave": "workspace",
  "go.formatTool": "goimports",
  "go.testFlags": ["-v", "-count=1"],
  "go.coverOnSave": false,
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.compositeLiteralFields": true,
  "go.inlayHints.parameterNames": true,
  "gopls": {
    "ui.completion.usePlaceholders": true,
    "ui.documentation.hoverKind": "FullDocumentation",
    "ui.completion.experimentalPostfixCompletions": true,
    "hints.assignVariableTypes": true,
    "hints.compositeLiteralFields": true,
    "hints.compositeLiteralTypes": true,
    "hints.constantValues": true,
    "hints.functionTypeParameters": true,
    "hints.parameterNames": true,
    "hints.rangeVariableTypes": true
  },

  // ============================================
  // 🌐 JAVASCRIPT & TYPESCRIPT — full inlay hints
  // ============================================
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.suggest.autoImports": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.returnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.autoImports": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "javascript.inlayHints.returnTypes.enabled": true,

  // ============================================
  // 🎨 TAILWIND CSS & NPM
  // ============================================
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.includeLanguages": {
    "plaintext": "html",
    "javascript": "javascriptreact"
  },
  "npm.fetchOnlinePackageInfo": true,

  // ============================================
  // 🐘 LARAVEL / PHP (Intelephense)
  // ============================================
  "php.suggest.basic": false,
  "php.validate.enable": true,
  "intelephense.environment.documentRoot": "public",
  "intelephense.files.associations": ["*.php", "*.blade.php"],
  "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": true,
  "intelephense.completion.insertUseDeclaration": true,
  "intelephense.completion.triggerParameterHints": true,

  // ============================================
  // ☕ JAVA
  // ============================================
  "jdk.jdkhome": "c:\\oracleJdk-25",

  // ============================================
  // 🌐 TRANSLATE & HOVER
  // ============================================
  "commentTranslate.targetLanguage": "id",
  "commentTranslate.hover.enabled": true,
  "editor.hover.enabled": "on",
  "editor.hover.delay": 300,
  "editor.parameterHints.enabled": true,
  "editor.parameterHints.cycle": true,
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.padding": true,

  // ============================================
  // 🖥️ SYSTEM & TERMINAL
  // ============================================
  "workbench.sideBar.location": "right",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font', Consolas",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.gpuAcceleration": "on",
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.shellIntegration.enabled": true,

  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Users\\rosea\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShell_8wekyb3d8bbwe\\pwsh.exe"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": { "id": "terminal-cmd" }
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash"
    },
    "Windows PowerShell": {
      "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
    }
  },

  // ============================================
  // 🚀 PRODUCTIVITY & WORKFLOW
  // ============================================
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    ".env": ".env.*",
    "tailwind.config.js": "tailwind.config.*, postcss.config.*",
    "next.config.js": "next-env.d.ts, tsconfig.json, jsconfig.json, .eslintrc.json",
    "*.ts": "${capture}.js, ${capture}.d.ts",
    "*.tsx": "${capture}.ts, ${capture}.js",
    "*.jsx": "${capture}.js",
    "composer.json": "composer.lock",
    "go.mod": "go.sum, .air.toml",
    "*.py": "${capture}.pyi",
    "pyproject.toml": "poetry.lock, requirements*.txt, setup.cfg, .python-version"
  },

  "editor.linkedEditing": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "blade": "html"
  },
  "emmet.triggerExpansionOnTab": true,

  // ============================================
  // 🐙 GIT & SOURCE CONTROL
  // ============================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ============================================
  // 🏷️ AUTO CLOSE TAG
  // ============================================
  "auto-close-tag.activationOnLanguage": [
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb",
    "cfml",
    "HTML (Eex)"
  ],

  // ============================================
  // 🎯 CODING COMFORT
  // ============================================
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.wordWrap": "on",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.dragAndDrop": false,
  "explorer.confirmDelete": false,

  // ============================================
  // 🐍 RUFF — Python linter (gantiin flake8 + isort)
  // ============================================
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true
}
